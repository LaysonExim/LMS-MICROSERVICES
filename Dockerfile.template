# Purpose: Multi-stage Dockerfile for Spring Boot microservices
# File: <service>/Dockerfile
# HOW TO USE: Copy this file into each service directory

# Stage 1: Build the application
FROM maven:3.9.6-eclipse-temurin-21 AS builder
WORKDIR /build

# Copy the entire project (needed for multi-module Maven build)
COPY pom.xml .
COPY <module-path>/pom.xml ./<module-path>/
COPY src ./src

# Build only this service and its dependencies
RUN mvn clean package -DskipTests -pl <module-path> -am

# Stage 2: Run the application
FROM eclipse-temurin:21-jre-slim
WORKDIR /app

# Copy the built JAR from the builder stage
COPY --from=builder /build/<module-path>/target/*.jar app.jar

# Expose the service port (overridden at runtime if needed)
EXPOSE 8080

# Run the application
ENTRYPOINT ["java", "-jar", "app.jar"]
